# Public Firebase Web configuration. These values are safe to expose in the
# browser; never put Firebase Admin credentials or service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional local emulator endpoints, for example 127.0.0.1:9099 and
# 127.0.0.1:8081. Leave them empty when using hosted Firebase services.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=

# Optional Vite API proxy target.
VITE_API_TARGET=http://localhost:8080
