# Local emulator configuration. These values are intentionally fake and are
# safe to use with the local Auth and Firestore emulators. Replace them with
# public Firebase Web values only when using hosted Firebase services.
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-crown-and-borough.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-crown-and-borough
VITE_FIREBASE_APP_ID=fake-app-id

# These endpoints are reached by the browser, not by Docker containers.
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8081

# Optional Vite API proxy target.
VITE_API_TARGET=http://localhost:8080
