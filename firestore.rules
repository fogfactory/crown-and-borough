rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberOf(gameId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.memberUids;
    }

    // The observer plays no house: the chat shows them every conversation. A
    // creator who plays reads their own conversations like any player.
    function observerOf(gameId) {
      return signedIn()
        && request.auth.uid == get(/databases/$(database)/documents/games/$(gameId)).data.get('spectatorUid', '');
    }

    // Profiles are synchronized by the authenticated Go API. Clients may read
    // their own projection but may not forge an email, UID, or membership.
    match /players/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // The game document is deliberately only a member-readable summary. The
    // membership test reads the document itself rather than memberOf(): a
    // list query is only granted when its own constraints prove the rule, and
    // where("memberUids", "array-contains", uid) proves this one.
    match /games/{gameId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /views/{uid} {
        allow read: if memberOf(gameId) && request.auth.uid == uid;
        allow write: if false;
      }

      // A non-playing creator receives a full-visibility observer projection.
      // The UID is part of the document path so another member cannot read it.
      match /observer/{uid} {
        allow read: if memberOf(gameId) && request.auth.uid == uid;
        allow write: if false;
      }

      match /reports/{uid}/turns/{turn} {
        allow read: if memberOf(gameId) && request.auth.uid == uid;
        allow write: if false;
      }

      // Chat. Messages are written by the Go API only. The public room is
      // readable by every member. A private conversation (key: the two house
      // identifiers, sorted) is readable by its two participants, whose uids
      // are on each message, and by the observer; clients query it with
      // where("participantUids", "array-contains", uid).
      match /chat_public/{messageId} {
        allow read: if memberOf(gameId);
        allow write: if false;
      }

      match /chat_private/{conversationKey}/messages/{messageId} {
        allow read: if memberOf(gameId)
          && (observerOf(gameId) || request.auth.uid in resource.data.participantUids);
        allow write: if false;
      }

      // Read cursors, one document per player.
      match /chat_reads/{uid} {
        allow read: if memberOf(gameId) && request.auth.uid == uid;
        allow write: if false;
      }

      // Rate-limit state: backend only.
      match /chat_state/{uid} {
        allow read, write: if false;
      }

      // Email notification state (last message email per player): backend
      // only.
      match /notify_state/{uid} {
        allow read, write: if false;
      }

      match /canonical/{document} {
        allow read, write: if false;
      }

      match /turns/{turn}/submissions/{uid} {
        allow read, write: if false;
      }

      // Unfiltered reports are backend-only. The nested filtered-report rule
      // above is more specific and is independently checked by the emulator.
      match /reports/{turn} {
        allow read, write: if false;
      }
    }

    // Last authenticated API request of each player, for the email
    // notifications: backend only.
    match /player_activity/{uid} {
      allow read, write: if false;
    }

    match /invitations/{codeHash} {
      allow read, write: if false;
    }

    // Bug reports hold a player's private game view: backend-only.
    match /bugReports/{reportId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
